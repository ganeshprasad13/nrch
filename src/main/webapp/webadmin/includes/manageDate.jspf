		sday = rsCurrentDete[0][0];
		smon = rsCurrentDete[0][1];
		syear = rsCurrentDete[0][2];
	}

//check if there are incoming parameter values for above dates otherwise specify today	
	if(request.getParameter("sday")!= null){
		sday = request.getParameter("sday");
	}

	if(request.getParameter("smon")!= null){
		smon = request.getParameter("smon");
	}

	if(request.getParameter("syear")!= null){
		syear = request.getParameter("syear");
	}

	if(request.getParameter("eday")!= null){
		eday = request.getParameter("eday");
	}

	if(request.getParameter("emon")!= null){
		emon = request.getParameter("emon");
	}

	if(request.getParameter("eyear")!= null){
		eyear = request.getParameter("eyear");
	}
