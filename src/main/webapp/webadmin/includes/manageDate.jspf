<%
	String strQuery = "select DATE_FORMAT(now(),'%d'),DATE_FORMAT(now(),'%m'),DATE_FORMAT(now(),'%Y') ";
	dbBean.setQuery(strQuery);
	String rsCurrentDete[][] = dbBean.getResultSet();
	
// initialise date variables
	String sday = "31";
	String smon = "12";
	String syear = "2010";
	String eday = "31";
	String emon = "12";
	String eyear = "2010";
